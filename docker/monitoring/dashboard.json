    {
      "id": 16,
      "title": "오류·경고 이벤트 · 원문은 Docker 로그에서 확인",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "nodease-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"nodease\",service=~\"$service\"} | json",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "nodease-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 17,
      "title": "수집 경로 상태 · 1 정상 / 0 실패",
