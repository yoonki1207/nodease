# Copy is not required when using `manage_compose.py init`; it generates the
# private `.env.load.local` file with mode 0600. These names document the
# local-only contract. Never place real values in this tracked example.
NODE_ENV=development
STORAGE_TYPE=LOCAL
SECRET_KEY=
MASTER_KEY=
ENCRYPTION_KEY=
LOAD_TEST_USER_PASSWORD=
LOAD_TEST_AUTH_TOKEN=
